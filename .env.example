# ==============================================================================
# YSS Partners - Website Configuration Template (.env.example)
#
# IMPORTANT:
# - Do NOT commit any .env files containing real secrets to version control.
# - Configure these environment variables in your Vercel Project Settings:
#   Settings > Environment Variables
# ==============================================================================

# Transactional Email Service (e.g., Resend)
# Leave blank during staging if direct email delivery is not yet configured.
RESEND_API_KEY=

# Sender & Default Recipient
CONTACT_EMAIL_FROM=notifications@ysspartners.com
CONTACT_EMAIL_TO=enquiries@ysspartners.com

# Category-Specific Email Routing (Pending client mailbox confirmation)
# If left blank, all enquiries will route to CONTACT_EMAIL_TO.
EXPORT_IMPORT_EMAIL=
IT_RISK_EMAIL=
PARTNERSHIP_EMAIL=
GENERAL_EMAIL=

# Optional SMTP Configuration (Alternative to Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Privacy Policy Link Override (Optional)
# Leave blank until the official privacy policy URL is approved by the client.
PRIVACY_POLICY_URL=

# Anti-Spam & Rate Limiting Controls
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MINUTES=10
